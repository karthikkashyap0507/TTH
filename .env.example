# Copy this file to .env.local and fill in what you need.

# Your live domain (used for SEO, sitemap and social share cards)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Password for the /admin dashboard (leads + job applications). Leave empty to disable admin.
ADMIN_PASSWORD=
# Optional: a separate long random string used to sign admin sessions
ADMIN_SECRET=

# Optional: get pinged on every new enquiry/application.
# Works with Slack / Discord / Google Chat incoming webhooks, or Zapier / Make / n8n hooks.
NOTIFY_WEBHOOK_URL=

# Optional: needed on serverless hosts (Vercel, Netlify) where files can't be written.
# Create a free database at https://upstash.com (Redis) and paste the REST credentials.
# Without these, data is saved to .data/db.json (fine for local dev or a VPS).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
